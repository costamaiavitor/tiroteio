// Regras do Firestore do Dan of Duty (projeto tiroteio-237ee).
// Publicar no console: Firestore Database → Regras → colar → Publicar (ver docs/seguranca/acoes_manuais.md).
// Elas aceitam exatamente o que o cliente honesto grava (index.html: newProfile l. 8149, cleanSk l. 8150,
// cleanProf l. 8151-8157, profSave l. 8160-8169, criação l. 8193) e recusam o resto. Espelham os achados
// D1 (forma), D3 (intervalo mínimo) e D4 (teto de salto por gravação) de docs/seguranca/auditoria/07-dados-banco.md.
//
// Antes de publicar, testar no Simulador de regras com os dois payloads reais (create e update) para um uid de teste.
// Se XP_CASE (index.html l. 8137) mudar de 300, mudar o teto de xp aqui junto.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{uid} {

      // ---- quem ----
      // Só o próprio jogador mexe no próprio documento (uid do Auth == id do documento).
      function dono() { return request.auth != null && request.auth.uid == uid; }

      // Dono do projeto (OWNERS, index.html l. 8138): grantAllSkins (l. 8139-8146) grava as 1100 skins de uma vez,
      // o que estoura o teto de +1 item por gravação. A isenção vale SÓ para os tetos de salto (items/cases),
      // nunca para a forma. Trocar o placeholder pelo uid real (Authentication → Users → coluna "UID do usuário").
      function donoDoProjeto() {
        return request.auth != null && request.auth.uid in ['COLOQUE_AQUI_O_UID_DO_DONO'];
      }

      // Estado final do documento depois da gravação (com merge, inclui os campos que já existiam).
      function d() { return request.resource.data; }
      // Estado anterior (só existe em update).
      function antes() { return resource.data; }

      // ---- forma de cada campo (espelha newProfile / cleanProf / cleanSk) ----
      function inteiro(v) { return v is int && v >= 0; }

      // items: lista de "arma:skin" (cleanProf l. 8154: W[arma] && SKIN_BY[skin]; ids de arma [a-z0-9_], de skin [a-z]).
      // 55 armas com skin x 20 acabamentos = 1100 no máximo; 1200 deixa folga para armas novas.
      function itensOk(l) {
        return l is list && l.size() <= 1200
          && l.join(',').matches('^$|^[a-z0-9_]{1,24}:[a-z]{1,16}(,[a-z0-9_]{1,24}:[a-z]{1,16})*$');
      }

      // equipped: mapa arma -> skin, mais a chave especial _faca (valor 'karambit'); cleanSk (l. 8150) corta em 80 chaves.
      function equipOk(m) {
        return m is map && m.keys().size() <= 80
          && m.keys().join(',').matches('^$|^[a-z0-9_]{1,24}(,[a-z0-9_]{1,24})*$')
          && m.values().join(',').matches('^$|^[a-z]{1,16}(,[a-z]{1,16})*$');
      }

      // Forma do documento inteiro. Campos gravados pelo cliente:
      //   criação (l. 8193):  { xp, cases, items, equipped, opened, name, created: serverTimestamp() }
      //   merge  (l. 8166):   { xp, cases, items, equipped, opened, name, upd: serverTimestamp() }
      // xp é number (pode ser fracionário: abate contra bot vale 7,5, l. 7742) e fica em [0, 300) porque
      // grantXP (l. 8221-8227) troca cada 300 XP por uma caixa. cases e opened são inteiros >= 0.
      // st: estatísticas (stat(), STK = k, d, hs, w, m, zk, zr), inteiros >= 0, só crescem no cliente honesto
      function statsOk(m) {
        return m is map && m.keys().hasOnly(['k', 'd', 'hs', 'w', 'm', 'zk', 'zr'])
          && (!('k' in m) || inteiro(m.k)) && (!('d' in m) || inteiro(m.d)) && (!('hs' in m) || inteiro(m.hs)) && (!('w' in m) || inteiro(m.w))
          && (!('m' in m) || inteiro(m.m)) && (!('zk' in m) || inteiro(m.zk)) && (!('zr' in m) || (inteiro(m.zr) && m.zr <= 10000));
      }
      function formaOk() {
        return d().keys().hasOnly(['xp', 'cases', 'items', 'equipped', 'opened', 'name', 'upd', 'created', 'st'])
          && d().keys().hasAll(['xp', 'cases', 'items', 'equipped', 'opened'])
          && (!('st' in d()) || statsOk(d().st))
          && d().xp is number && d().xp >= 0 && d().xp < 300
          && inteiro(d().cases) && d().cases <= 100000
          && inteiro(d().opened) && d().opened <= 1000000
          && itensOk(d().items)
          && equipOk(d().equipped)
          && (!('name' in d()) || (d().name is string && d().name.size() <= 100));
      }

      // ---- D4: teto de salto por gravação (update) ----
      // Uma rodada alta inteira entra numa só gravação (profSave reinicia o atraso de 3 s a cada XP) e rende
      // 1-2 caixas; o fim de jogo na rodada 40 mais 1-2. +10 caixas (3000 XP) por gravação é folgado para o
      // jogador honesto e torna "cases: 999999" impossível numa só escrita.
      // Abrir caixa (openCaseUI l. 8366-8373) faz cases--, opened++ e items.push(1): a caixa só cai 1 e só se
      // opened subiu exatamente 1; items cresce no máximo 1 por gravação.
      function saltoOk() {
        return d().cases <= antes().cases + 10
          && d().cases >= antes().cases - 1
          && (d().cases >= antes().cases || d().opened == antes().opened + 1)
          && d().items.size() <= antes().items.size() + 1;
      }

      // ---- D4: tetos absolutos na criação ----
      // O create não tem estado anterior: um convidado com localStorage editado entraria com qualquer valor.
      // Um convidado honesto dificilmente passa de 200 caixas ou 400 skins antes de criar a conta.
      function tetosCriacao() {
        return d().cases <= 200 && d().items.size() <= 400; // convidado que jogou muito antes de criar a conta ainda passa; o salto absurdo (cases 999999) não
      }

      // ---- D3: intervalo mínimo de 1 s entre gravações ----
      // upd é serverTimestamp() (l. 8166). O cliente honesto grava no máximo a cada 3 s; o único caso de duas
      // gravações imediatas no mesmo segundo (abrir caixa + esconder a aba) é refeito na próxima mudança, com o
      // estado guardado no localStorage. Documento criado e nunca atualizado não tem upd: exceção.
      function intervaloOk() {
        return !('upd' in antes()) || request.time > antes().upd + duration.value(1, 's');
      }

      // ---- permissões ----
      allow get: if dono();
      allow list: if false;                     // o app nunca consulta a coleção

      // Criação (l. 8193): created é serverTimestamp(); a alternativa sem created cobre o documento recriado
      // pelo merge da l. 8166 depois de apagado à mão no console. Nunca traz upd.
      allow create: if dono() && formaOk()
        && (!('created' in d()) || d().created == request.time)
        && !('upd' in d())
        && (donoDoProjeto() || tetosCriacao());

      // Atualização com merge (l. 8166): upd é serverTimestamp(); created é imutável; caixas abertas nunca
      // diminuem; intervalo mínimo; teto de salto (o dono do projeto fica isento só do teto).
      allow update: if dono() && formaOk()
        && d().upd == request.time
        && (!('created' in antes()) || d().created == antes().created)
        && d().opened >= antes().opened
        && intervaloOk()
        && (donoDoProjeto() || saltoOk());

      allow delete: if false;                   // o app não exclui (ver D8 se um dia tiver "Excluir conta")
    }

    // ---- Aba Amigos (usuário fixo, amizades e convites), como no README da main ----
    // usuário fixo de cada conta (o ID do documento é o usuário); o dono grava também seen/room/rp/st (presença)
    match /usernames/{name} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid && name.matches('^[a-z0-9_]{3,16}$');
      allow update: if request.auth != null && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
    }
    // amizades: pedido (pending) e aceito (ok)
    match /friends/{id} {
      allow read, delete: if request.auth != null && request.auth.uid in resource.data.users;
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid
        && request.auth.uid in request.resource.data.users && request.resource.data.users.size() == 2 && request.resource.data.st == 'pending';
      allow update: if request.auth != null && request.auth.uid in resource.data.users && request.auth.uid != resource.data.from
        && request.resource.data.st == 'ok' && request.resource.data.users == resource.data.users && request.resource.data.from == resource.data.from;
    }
    // convites para o lobby
    match /invites/{id} {
      allow read, delete: if request.auth != null && (request.auth.uid == resource.data.to || request.auth.uid == resource.data.from);
      allow create, update: if request.auth != null && request.resource.data.from == request.auth.uid;
    }
  }
}
